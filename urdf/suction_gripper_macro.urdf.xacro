<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ecpmi_gripper">
    <xacro:macro name="ecpmi_gripper" params="parent *origin tf_prefix">
        <link name="${tf_prefix}ecpmi_gripper_base_link">
            <visual>
                <origin xyz="0 0 0.035" rpy="4.7124 0 0.785" />
                <geometry>
                    <!-- Using STL for visual instead of DAE (Looks better :) ) -->
                    <mesh filename="package://ur_description/meshes/collision/ecpmi_gripper.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="gripper_material">
                    <color rgba="0.7 0.7 0.7 1.0"/>
                </material>
            </visual>
            
            <collision>
                <origin xyz="0 0 0.035" rpy="4.7124 0 0.785" />
                <geometry>
                    <mesh filename="package://ur_description/meshes/collision/ecpmi_gripper.stl" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
            
            <inertial>
                <mass value="0.2"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
            </inertial>
        </link>

        <!-- Join the gripper to the parent link (tool0) -->
        <joint name="${tf_prefix}ecpmi_gripper_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="${tf_prefix}ecpmi_gripper_base_link"/>
            <xacro:insert_block name="origin"/>
        </joint>

        <!-- Mount reference frame positioned -31.5mm in x relative to parent -->
        <link name="${tf_prefix}mount_reference">
            <!-- Empty link for reference frame only -->
        </link>

        <joint name="${tf_prefix}mount_reference_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="${tf_prefix}mount_reference"/>
            <origin xyz="-0.0315 0 0.007" rpy="0 0 0"/>
        </joint>

        <!-- Gripper tip link at the center bottom of the gripper -->
        <link name="${tf_prefix}ecpmi_gripper_tip">
            <visual>
                <origin xyz="0 0 0" rpy="4.7124 0 0.785" />
                <geometry>
                    <mesh filename="package://ur_description/meshes/collision/ecpmi_gripper_tip.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="gripper_tip_material">
                    <color rgba="0.5 0.5 0.5 1.0"/>
                </material>
            </visual>
            
            <collision>
                <origin xyz="0 0 0" rpy="4.7124 0 0.785" />
                <geometry>
                    <mesh filename="package://ur_description/meshes/collision/ecpmi_gripper_tip.stl" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
            
            <inertial>
                <mass value="0.001"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
            </inertial>
        </link>

        <!-- Joint connecting gripper base to tip -->
        <joint name="${tf_prefix}ecpmi_gripper_tip_joint" type="fixed">
            <parent link="${tf_prefix}ecpmi_gripper_base_link"/>
            <child link="${tf_prefix}ecpmi_gripper_tip"/>
            <origin xyz="0 0 0.072" rpy="0 0 0"/>
        </joint>
    </xacro:macro>
</robot>