<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="custom_gripper">
    <xacro:macro name="custom_gripper" params="parent *origin tf_prefix">
        <link name="${tf_prefix}custom_gripper_base_link">
            <visual>
                <origin xyz="0 0 0" rpy="1.5708 0 0.785" />
                <geometry>
                    <!-- Using STL for visual instead of DAE (Looks better :) ) -->
                    <mesh filename="package://ur_description/meshes/collision/custom_gripper_model.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="gripper_material">
                    <color rgba="0.7 0.7 0.7 1.0"/>
                </material>
            </visual>
            
            <collision>
                <origin xyz="0 0 0" rpy="1.5708 0 0.785" />
                <geometry>
                    <mesh filename="package://ur_description/meshes/collision/custom_gripper_model.stl" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
            
            <inertial>
                <mass value="0.2"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
            </inertial>
        </link>

        <!-- Join the gripper to the parent link (tool0) -->
        <joint name="${tf_prefix}custom_gripper_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="${tf_prefix}custom_gripper_base_link"/>
            <xacro:insert_block name="origin"/>
        </joint>
    </xacro:macro>
</robot>